# Copy this file to .env and replace every placeholder.
# Application secrets belong in Vault, not in this file.

POSTGRES_DB=team_platform
POSTGRES_USER=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set these to the host user's numeric IDs so Vault Agent can read the
# owner-only AppRole credential files (Linux/macOS: id -u and id -g).
VAULT_AGENT_UID=1000
VAULT_AGENT_GID=1000

# For Compose, keep the PostgreSQL password in the protected
# vault/credentials/postgres-password file.
# Optional for local non-Compose backend runs only.
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/team_platform

# Public origin served by the Nginx + ModSecurity + OWASP CRS gateway.
# Use only scheme, host, and optional port (no path or trailing slash).
WAF_PUBLIC_ORIGIN=http://localhost:8080
# Host bind address is loopback-only by default; keep this for local HTTP use.
# Non-loopback access requires a trusted TLS-terminating ingress.
WAF_BIND_ADDRESS=127.0.0.1
# Host HTTP port for the gateway. Set WAF_PUBLIC_ORIGIN to match if changed.
WAF_HTTP_PORT=8080
WAF_SERVER_NAME=localhost

# Microsoft Entra app registration for sign-in and delegated education roster sync.
# Register this exact redirect URI as a Web redirect URI in Entra.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-application-client-id
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/auth/microsoft/callback

# Use true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=14

# API request limits are process-local by default for development. Use a shared
# Redis URL in production so limits persist across app workers and restarts.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
# API_RATE_LIMIT=300 per hour
# API_GLOBAL_RATE_LIMIT=1200 per hour

# Local disk is the selected storage backend for this phase.
STORAGE_BACKEND=local
STORAGE_ROOT=/absolute/path/to/ft_transcendence/be/uploads

MAX_CONTENT_LENGTH_BYTES=115343360
STORAGE_MAX_AVATAR_BYTES=5242880
STORAGE_MAX_PROJECT_REQUIREMENTS_BYTES=20971520
STORAGE_MAX_TASK_ATTACHMENT_BYTES=26214400
STORAGE_MAX_PROJECT_SUBMISSION_BYTES=104857600
