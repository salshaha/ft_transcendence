# Copy this file to .env and replace every placeholder.
SECRET_KEY=replace-with-a-long-random-secret

POSTGRES_DB=team_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: overrides the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/team_platform

FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated list when more than one origin is needed.
# FRONTEND_ORIGINS=http://localhost:5173,https://app.example.com

# Use true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_DAYS=14

# Local disk is the selected storage backend for this phase.
STORAGE_BACKEND=local
STORAGE_ROOT=/absolute/path/to/ft_transcendence/be/uploads

MAX_CONTENT_LENGTH_BYTES=115343360
STORAGE_MAX_AVATAR_BYTES=5242880
STORAGE_MAX_PROJECT_REQUIREMENTS_BYTES=20971520
STORAGE_MAX_TASK_ATTACHMENT_BYTES=26214400
STORAGE_MAX_PROJECT_SUBMISSION_BYTES=104857600

###
POSTGRES_DB=team_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_PORT=5432

# Microsoft Entra ID (organizational accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback
